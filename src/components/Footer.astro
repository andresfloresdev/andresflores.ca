---
/*
  The footer, on night: the contact band (the target of every "Contact"
  link, `#contact`), the profiles, Montreal's time, the legal row, and the
  name set huge in flame, rising out of its mask.

  It sits inside #swup (Layout.astro), so it is swapped with the page.
*/
import Arrow from './Arrow.astro';
import FormattedDate from './FormattedDate.astro';
import { PERSON, PROFILES } from '../config/site';
import { copyFor } from '../i18n/copy';
import type { Alternates } from '../i18n/alternates';
import { LOCALES, LOCALE_KEYS, type Locale } from '../i18n/config';
import { CONTACT_HASH, LEGAL } from '../i18n/routes';
import { pathTo, useTranslations } from '../i18n/utils';
import { richHtml } from '../lib/rich';

interface Props {
	locale: Locale;
	alternates: Alternates;
}

const { locale, alternates } = Astro.props;
const t = useTranslations(locale);
const c = copyFor(locale).contact;
const year = new Date().getFullYear();
---

<footer class="ground-night" id={CONTACT_HASH}>
	<div class="wrap">
		<div class="grid-12 gap-y-10 pt-[var(--section-y)] pb-16">
			<p class="label col-span-12 lg:col-span-3" data-anim="label">{c.label}</p>
			<div class="col-span-12 lg:col-span-9">
				<h2 class="text-h2 max-w-[16ch]" data-anim="lines" set:html={richHtml(c.title)} />
				<p class="mt-6 text-xl text-[var(--fg-muted)]" data-anim="rise" data-delay="0.1">{c.body}</p>
				<div class="mt-10" data-anim="rise" data-delay="0.2">
					<a href={`mailto:${PERSON.email}`} class="mail-link">
						<span>{PERSON.email}</span>
						<Arrow />
					</a>
				</div>
			</div>
		</div>

		<span class="rule" data-anim="rule" aria-hidden="true"></span>

		<div class="grid-12 gap-y-8 py-10 text-sm">
			<div class="col-span-6 md:col-span-3">
				<p class="mono text-[var(--fg-muted)]">{t('footer.elsewhere')}</p>
				<ul class="footer-links mt-4 space-y-2">
					{
						PROFILES.map((p) => (
							<li>
								<a href={p.url} class="link" target="_blank" rel="me noopener">
									{p.label}
								</a>
							</li>
						))
					}
				</ul>
			</div>
			<div class="col-span-6 md:col-span-3">
				<p class="mono text-[var(--fg-muted)]">{t('footer.time')}</p>
				<p class="mt-4 text-h4 tabular-nums" data-clock aria-live="off">--:--</p>
			</div>
			<div class="col-span-6 md:col-span-3">
				<p class="mono text-[var(--fg-muted)]">{t('nav.language')}</p>
				<ul class="footer-links mt-4 space-y-2">
					{
						LOCALE_KEYS.map((code) =>
							code === locale ? (
								<li aria-current="true">{LOCALES[code].label}</li>
							) : alternates[code] ? (
								<li>
									<a href={alternates[code]} class="link" hreflang={LOCALES[code].htmlLang} lang={LOCALES[code].htmlLang} data-no-swup>
										{LOCALES[code].label}
									</a>
								</li>
							) : null,
						)
					}
				</ul>
			</div>
			<div class="col-span-6 md:col-span-3">
				<p class="mono text-[var(--fg-muted)]">{t('nav.legal')}</p>
				<ul class="footer-links mt-4 space-y-2">
					{
						LEGAL.map((key) => {
							const href = pathTo(locale, key);
							return href ? (
								<li>
									<a href={href} class="link">
										{t(`nav.${key}` as 'nav.home')}
									</a>
								</li>
							) : null;
						})
					}
					<li>
						<a href="#top" class="link">{t('nav.backToTop')}</a>
					</li>
				</ul>
			</div>
		</div>

		<div class="pb-6" aria-hidden="true">
			<span class="footer-wordmark" data-anim="wordmark" data-start="top 98%"><span>Andrés Flores</span></span>
		</div>

		<div class="flex flex-wrap justify-between gap-4 border-t border-[var(--rule)] py-6 text-xs text-[var(--fg-muted)]">
			<p class="mono">© 2015–{year} {PERSON.name}. {t('footer.rights')}</p>
			<p class="mono">{PERSON.city[locale]}, {PERSON.region}</p>
		</div>
	</div>
</footer>
