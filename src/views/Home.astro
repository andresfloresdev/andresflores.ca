---
/*
  Home. The order is the brief's (docs/brief/site-brief.md):

    1. hero        the name set huge, the portrait as a pill inside it
    2. statement   who he is in one paragraph; words light up on scroll
    3. ventures    Agence Flores and Carte Blanche, as rows
    4. journey     2015 to today; a sticky year follows the step in view
    5. brands      a marquee of brands he worked on
    6. ai          how he works with AI, in his approved words (AF-02)
    7. about       a pointer to the About page, the page assistants quote

  Every fact comes from src/config/site.ts; every sentence from
  src/i18n/copy/<locale>.ts. The view holds layout only, and no script.
*/
import { Image } from 'astro:assets';
import Arrow from '../components/Arrow.astro';
import Button from '../components/Button.astro';
import portrait from '../assets/andres-flores.jpg';
import { AGENCY, CARTE_BLANCHE, CLIENTS, JOURNEY, PERSON } from '../config/site';
import { copyFor } from '../i18n/copy';
import type { Locale } from '../i18n/config';
import { pathTo } from '../i18n/utils';
import Layout from '../layouts/Layout.astro';
import { nb, pad, richHtml } from '../lib/rich';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const c = copyFor(locale).home;
const aboutHref = pathTo(locale, 'about') ?? `/${locale}/`;

const steps = JOURNEY.map((s) => ({
	...s,
	big: s.year ? String(s.year) : s.when[locale],
	small: s.title[locale],
}));

// Each half of the marquee holds the list twice, so one half is always wider than the screen.
const half = [...CLIENTS, ...CLIENTS];
---

<Layout locale={locale} view="home" ogType="profile">
	<!-- 1. Hero -->
	<section class="hero wrap" data-intro>
		<div class="flex flex-wrap items-start justify-between gap-x-8 gap-y-2">
			<p class="mono" data-anim="rise" data-delay="0.9">{c.hero.kicker}</p>
			<p class="mono text-muted" data-anim="rise" data-delay="1">{c.hero.place}</p>
		</div>

		<h1 class="hero__name">
			<span class="hero__line" data-anim="wordmark" data-delay="0.05"><span>Andrés</span></span>
			<span class="hero__line hero__line--2" data-anim="wordmark" data-delay="0.2">
				<span>
					<span class="hero__pill" data-anim="pill" data-delay="0.55">
						<Image
							src={portrait}
							alt={c.hero.portraitAlt}
							widths={[240, 480, 720]}
							sizes="(min-width: 1024px) 360px, 160px"
							loading="eager"
							fetchpriority="high"
						/>
					</span>
					Flores
				</span>
			</span>
		</h1>

		<div class="grid-12 items-end gap-y-6">
			<p class="col-span-12 max-w-[38ch] text-lg md:col-span-7 lg:col-span-5" data-anim="lines" data-delay="1.05">
				{nb(PERSON.oneLine[locale])}
			</p>
			<div class="col-span-6 md:col-span-3 md:col-start-9 lg:col-span-2 lg:col-start-9" data-anim="rise" data-delay="1.2">
				<p class="mono text-muted">{c.hero.since}</p>
			</div>
			<div class="col-span-6 justify-self-end md:col-span-2 md:col-start-11" data-anim="rise" data-delay="1.3">
				<a href="#statement" class="scroll-cue mono" aria-label={c.hero.scroll}>
					<span>{c.hero.scroll}</span>
					<span class="scroll-cue__bar" aria-hidden="true"></span>
				</a>
			</div>
		</div>
	</section>

	<!-- 2. Statement -->
	<section class="section wrap" id="statement">
		<span class="rule mb-10" data-anim="rule" aria-hidden="true"></span>
		<div class="grid-12 gap-y-8">
			<p class="label col-span-12 lg:col-span-3" data-anim="label">{c.statement.label}</p>
			<p class="manifesto col-span-12 lg:col-span-9" data-scrub-words>{c.statement.text}</p>
		</div>
	</section>

	<!-- 3. Ventures -->
	<section class="wrap pb-[var(--section-y)]">
		<div class="grid-12 mb-12 items-end gap-y-6">
			<p class="label col-span-12 lg:col-span-3" data-anim="label">{c.ventures.label}</p>
			<h2 class="text-h2 col-span-12 lg:col-span-9" data-anim="lines" set:html={richHtml(c.ventures.title)} />
		</div>

		<ul data-anim="stagger">
			<li class="venture venture--link">
				<a href={AGENCY.url} target="_blank" rel="noopener" class="venture__row grid-12">
					<span class="venture__fill" aria-hidden="true"></span>
					<span class="idx col-span-2 lg:col-span-1">({pad(1)})</span>
					<span class="col-span-10 lg:col-span-5">
						<span class="venture__title block">{AGENCY.name}</span>
						<span class="venture__meta mono mt-3 block text-muted">{c.ventures.agency.meta}</span>
					</span>
					<span class="venture__body col-span-12 lg:col-span-4 lg:col-start-7">{c.ventures.agency.body}</span>
					<span class="col-span-12 flex items-center justify-between gap-4 lg:col-span-2 lg:flex-col lg:items-end lg:justify-start">
						<span class="mono">{c.ventures.agency.cta}</span>
						<span class="venture__go" aria-hidden="true"><Arrow /></span>
					</span>
				</a>
			</li>
			<li class="venture">
				<div class="venture__row grid-12">
					<span class="idx col-span-2 lg:col-span-1">({pad(2)})</span>
					<span class="col-span-10 lg:col-span-5">
						<span class="venture__title block">{CARTE_BLANCHE.name}</span>
						<span class="venture__meta mono mt-3 block text-muted">{c.ventures.carteBlanche.meta}</span>
					</span>
					<span class="venture__body col-span-12 lg:col-span-4 lg:col-start-7">{c.ventures.carteBlanche.body}</span>
					<span class="col-span-12 lg:col-span-2 lg:text-right">
						<span class="mono text-muted">{c.ventures.carteBlanche.cta}</span>
					</span>
				</div>
			</li>
		</ul>
	</section>

	<!-- 4. Journey -->
	<section class="ground-sand section" data-journey>
		<div class="wrap">
			<div class="grid-12 mb-14 items-end gap-y-6">
				<p class="label col-span-12 lg:col-span-3" data-anim="label">{c.journey.label}</p>
				<h2 class="text-h2 col-span-12 lg:col-span-9" data-anim="lines" set:html={richHtml(c.journey.title)} />
			</div>

			<div class="grid-12 gap-y-10">
				<div class="col-span-12 hidden lg:col-span-5 lg:block">
					<div class="journey__sticky" aria-hidden="true">
						<span class="journey__year" data-journey-year><span>{steps[0].big}</span></span>
						<p class="mono mt-6 text-muted" data-journey-caption>{steps[0].small}</p>
					</div>
				</div>

				<ol class="journey__list col-span-12 lg:col-span-7" data-journey-list>
					<span class="journey__track" aria-hidden="true"></span>
					<span class="journey__progress" aria-hidden="true" data-journey-progress></span>
					{
						steps.map((step) => (
							<li class="journey__item" data-step data-big={step.big} data-small={step.small}>
								<p class="mono text-muted" data-anim="rise">
									{step.when[locale]}
								</p>
								<h3 class="journey__title mt-3" data-anim="lines">
									{step.title[locale]}
								</h3>
								<p class="mt-4 max-w-[44ch] text-lg text-muted" data-anim="rise" data-delay="0.1">
									{step.body[locale]}
								</p>
								{'link' in step && step.link && (
									<p class="mt-5" data-anim="rise" data-delay="0.15">
										<a href={step.link.url} target="_blank" rel="noopener" class="link mono inline-flex items-center gap-2">
											{step.link.name}
										</a>
									</p>
								)}
							</li>
						))
					}
				</ol>
			</div>
		</div>
	</section>

	<!-- 5. Brands -->
	<section class="section pb-0">
		<div class="wrap grid-12 mb-10 gap-y-6">
			<p class="label col-span-12 lg:col-span-3" data-anim="label">{c.brands.label}</p>
			<p class="col-span-12 max-w-[42ch] text-xl lg:col-span-6" data-anim="lines">{c.brands.text}</p>
		</div>
		<div class="marquee" data-marquee>
			<ul class="marquee__track" data-marquee-track>
				{half.map((name, i) => <li class="marquee__item" aria-hidden={i >= CLIENTS.length ? 'true' : undefined}>{name}</li>)}
				{half.map((name) => <li class="marquee__item" aria-hidden="true">{name}</li>)}
			</ul>
		</div>
	</section>

	<!-- 6. AI -->
	<section class="section">
		<div class="wrap">
			<div class="ground-night overflow-hidden rounded-[clamp(1rem,0.6rem+1.5vw,2rem)] px-[var(--margin)] py-[var(--section-y)]">
				<div class="grid-12 gap-y-10">
					<p class="label col-span-12 lg:col-span-3" data-anim="label">{c.ai.label}</p>
					<div class="col-span-12 lg:col-span-9">
						<h2 class="text-h1 max-w-[14ch]" data-anim="lines" set:html={richHtml(c.ai.title)} />
						<p class="mt-8 max-w-[40ch] text-xl text-[var(--fg-muted)]" data-anim="rise" data-delay="0.15">{c.ai.lead}</p>
					</div>
				</div>
				<ol class="grid-12 mt-16 gap-y-0" data-anim="stagger">
					{
						c.ai.rows.map((row, i) => (
							<li class="col-span-12 grid grid-cols-subgrid gap-y-3 border-t border-[var(--rule)] py-7 md:col-span-4 md:block md:border-t-0 md:border-l md:py-0 md:pr-6 md:pl-6 md:first:border-l-0 md:first:pl-0">
								<span class="idx col-span-2 md:block">({pad(i + 1)})</span>
								<span class="col-span-10 md:mt-8 md:block">
									<span class="block text-h4 font-semibold">{row.title}</span>
									<span class="mt-3 block text-lg text-[var(--fg-muted)]">{row.body}</span>
								</span>
							</li>
						))
					}
				</ol>
			</div>
		</div>
	</section>

	<!-- 7. About teaser -->
	<section class="wrap pb-[var(--section-y)]">
		<div class="grid-12 items-end gap-y-10">
			<div class="frame col-span-12 aspect-square md:col-span-5 lg:col-span-4" data-anim="frame" data-parallax="6">
				<Image src={portrait} alt="" widths={[400, 800]} sizes="(min-width: 1024px) 33vw, (min-width: 768px) 42vw, 100vw" />
			</div>
			<div class="col-span-12 md:col-span-7 lg:col-span-7 lg:col-start-6">
				<p class="label" data-anim="label">{c.about.label}</p>
				<h2 class="text-h1 mt-6 max-w-[13ch]" data-anim="lines" set:html={richHtml(c.about.title)} />
				<div class="mt-10" data-anim="rise" data-delay="0.2">
					<Button href={aboutHref}>{c.about.cta}</Button>
				</div>
			</div>
		</div>
	</section>
</Layout>
